# frontend/dashboard/dist/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Logs
*.log
pm2-*.log

# OS
.DS_Store
Thumbs.db

# Any local env file, in any package (keep the committed templates/examples)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
