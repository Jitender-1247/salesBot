# ── SalesBot Backend Configuration ──

# Core
MONGODB_URI=mongodb://localhost:27017/salesbot
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be 32+ characters in production. The server refuses to start without it.
JWT_SECRET=
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# LiveKit (Avatar / WebRTC)
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LLM (Groq / OpenAI)
GROQ_API_KEY=your-groq-key
# OPENAI_API_KEY=your-openai-key

# STT (Speech-to-Text) — Cascade: Deepgram > Groq > OpenAI > Local Whisper
# Deepgram Nova-2 (RECOMMENDED — $200 free credits at deepgram.com)
DEEPGRAM_API_KEY=
# Groq Whisper is auto-used via GROQ_API_KEY above (free tier)

# TTS (Text-to-Speech — ElevenLabs / Deepgram)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Local Python servers (servers/). Docker Compose sets these automatically.
TTS_BASE_URL=http://localhost:8000
STT_BASE_URL=http://localhost:8787

# Zoho CRM Integration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com

# ── Scaling & High-Traffic Config ──

# Max demo session duration in seconds (default: 300 = 5 minutes)
MAX_SESSION_DURATION_SECONDS=300

# Max concurrent demo sessions before queueing (default: 50)
MAX_CONCURRENT_SESSIONS=50

# Redis URL for multi-node Socket.IO + session tracking
# Leave empty for single-node dev mode (in-memory fallback)
REDIS_URL=

# Remote browser grid endpoint (Browserless / Chrome pool)
# Leave empty to use local Chromium (dev mode)
# Example: ws://localhost:3000 or wss://browserless.example.com?token=xxx
BROWSER_WS_ENDPOINT=

# Encryption key for stored product credentials and session cookies.
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes previously stored credentials unreadable.
ENCRYPTION_KEY=

# ── Security ──

# Allow product URLs / demo navigation to localhost, LAN and cloud-internal addresses.
# Keep false in production (prevents SSRF, e.g. reading cloud metadata credentials).
# Set true only for local development against an app running on your machine.
ALLOW_PRIVATE_URLS=false

# Which proxies to trust for X-Forwarded-For (Express "trust proxy" syntax).
# Default trusts loopback and private networks (nginx on the same host or Docker bridge).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Max demo/chat sessions one IP can start per 10 minutes
# SESSION_STARTS_PER_IP=10
# Seconds a call stays alive after the visitor's socket drops, so a reconnect can resume it
# SESSION_RESUME_GRACE_SECONDS=30
